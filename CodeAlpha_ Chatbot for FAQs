# Simple Command-Line Interface
def run_cli_chatbot():
    """Run the chatbot in command-line interface mode"""
    print("=" * 70)
    print(" FAQ CHATBOT - Your Virtual Assistant")
    print("=" * 70)
    print("\nI can answer questions about our products and services.")
    print("Type 'quit' to exit, 'help' for commands, 'stats' for summary.\n")

    # Initialize chatbot
    faqs = get_sample_faqs()
    chatbot = FAQChatbot(faqs)

    print("\n" + "=" * 70)
    print("Chatbot is ready! Ask me anything.")
    print("Example questions: return policy, shipping time, payment methods")
    print("=" * 70 + "\n")

    while True:
        # Get user input
        user_input = input("You: ").strip()

        # Handle commands
        if user_input.lower() in ['quit', 'exit', 'q']:
            print("\n Thank you for chatting! Have a great day!")
            break

        elif user_input.lower() == 'help':
            print("\n Commands:")
            print("  • 'quit' or 'exit' - End the conversation")
            print("  • 'help' - Show this help message")
            print("  • 'stats' - Show conversation statistics")
            print("  • 'faqs' - List all available FAQ topics")
            print("\n Tips:")
            print("  • Ask naturally like talking to a human")
            print("  • Be specific for better matching")
            print("  • Try rephrasing if not satisfied")
            continue

        elif user_input.lower() == 'stats':
            stats = chatbot.get_conversation_summary()
            print(f"\n Conversation Statistics:")
            print(f"  • Total queries: {stats['total_queries']}")
            print(f"  • Average confidence: {stats['avg_confidence']:.2%}")
            if stats['topics']:
                print(f"  • Topics discussed: {len(stats['topics'])}")
                print(f"  • Recent topics: {', '.join(stats['topics'][:3])}")
            continue

        elif user_input.lower() == 'faqs':
            print("\n Available FAQ Topics:")
            for i, q in enumerate(chatbot.questions, 1):
                print(f"  {i:2}. {q}")
            continue

        elif not user_input:
            continue

        # Get chatbot response
        answer, confidence = chatbot.get_best_answer(user_input,
                                                     threshold=0.1,
                                                     return_confidence=True)

        if answer:
            print(f"\n Bot: {answer}")
            print(f"   (Confidence: {confidence:.1%})\n")
        else:
            # Fallback response
            response = chatbot.handle_fallback(user_input)
            print(f"\n Bot: {response}")
            if confidence is not None:
                print(f"   (Low confidence: {confidence:.1%})\n")

        # Show alternative suggestions if confidence is low but not zero
        if confidence and 0 < confidence < 0.3:
            alternatives = chatbot.get_multiple_answers(user_input, top_k=2, threshold=0.15)
            if alternatives:
                print(" Did you mean one of these?")
                for ans, q, score in alternatives:
                    print(f"  • {q[:70]}... (match: {score:.1%})")
                print()


# Main entry point
if __name__ == "__main__":
    run_cli_chatbot()
