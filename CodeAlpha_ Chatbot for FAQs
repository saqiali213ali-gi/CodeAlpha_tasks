import re
import numpy as np
from typing import List, Dict, Tuple, Optional
import warnings
warnings.filterwarnings('ignore')

# Import and setup NLTK
import nltk

# Download ALL required NLTK data at once
def setup_nltk():
    """Download all required NLTK datasets"""
    required_resources = ['punkt', 'punkt_tab', 'stopwords', 'wordnet']

    for resource in required_resources:
        try:
            # Check if resource exists
            if resource == 'punkt' or resource == 'punkt_tab':
                nltk.data.find(f'tokenizers/{resource}')
            else:
                nltk.data.find(f'corpora/{resource}')
            print(f" {resource} already available")
        except LookupError:
            print(f" Downloading {resource}...")
            nltk.download(resource, quiet=True)
            print(f" {resource} downloaded")

# Run the setup
setup_nltk()

# Now import the rest
from nltk.corpus import stopwords
from nltk.stem import WordNetLemmatizer
from nltk.tokenize import word_tokenize

# Scikit-learn for similarity
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity


class FAQChatbot:
    """Simple FAQ Chatbot using TF-IDF similarity"""

    def __init__(self, faq_data: List[Dict[str, str]]):
        """
        Initialize the FAQ Chatbot.

        Args:
            faq_data: List of dictionaries with 'question' and 'answer' keys
        """
        self.faq_data = faq_data

        # Initialize NLP tools
        self.stop_words = set(stopwords.words('english'))
        self.lemmatizer = WordNetLemmatizer()

        # Extract questions and answers
        self.questions = [item['question'] for item in faq_data]
        self.answers = [item['answer'] for item in faq_data]

        # Preprocess questions
        print("Preprocessing FAQs...")
        self.processed_questions = [self.preprocess_text(q) for q in self.questions]

        # Build TF-IDF vectors
        self.vectorizer = TfidfVectorizer(
            max_features=500,
            ngram_range=(1, 2),
            stop_words='english'
        )
        self.question_vectors = self.vectorizer.fit_transform(self.processed_questions)

        # Conversation history
        self.conversation_history = []

        print(f"Loaded {len(self.questions)} FAQs")

    def preprocess_text(self, text: str) -> str:
        """
        Preprocess text: lowercase, remove punctuation, remove stopwords,
        tokenize, and apply lemmatization.
        """
        # Convert to lowercase
        text = text.lower()

        # Remove punctuation and special characters
        text = re.sub(r'[^\w\s]', ' ', text)

        # Remove extra whitespace
        text = re.sub(r'\s+', ' ', text).strip()

        # Tokenize with error handling
        try:
            tokens = word_tokenize(text)
        except:
            # Fallback: simple split if tokenization fails
            tokens = text.split()

        # Remove stopwords and short words, apply lemmatization
        tokens = [self.lemmatizer.lemmatize(t) for t in tokens
                 if t not in self.stop_words and len(t) > 2]

        return ' '.join(tokens)

    def get_similarity_scores(self, user_question: str) -> List[Tuple[int, float]]:
        """
        Calculate similarity between user question and all FAQs.

        Returns:
            List of (index, similarity_score) tuples sorted by score
        """
        processed_user = self.preprocess_text(user_question)

        # Transform user question to TF-IDF vector
        user_vector = self.vectorizer.transform([processed_user])

        # Calculate cosine similarity
        similarities = cosine_similarity(user_vector, self.question_vectors)[0]

        # Get indices sorted by similarity score
        indices = np.argsort(similarities)[::-1]
        sorted_scores = [(idx, similarities[idx]) for idx in indices]

        return sorted_scores

    def get_best_answer(self, user_question: str,
                       threshold: float = 0.1,
                       return_confidence: bool = False):
        """
        Get the best matching answer for the user's question.

        Args:
            user_question: User's input question
            threshold: Minimum similarity threshold (0-1)
            return_confidence: Whether to return confidence score

        Returns:
            Best matching answer or None if below threshold
        """
        # Get similarity scores
        similarity_scores = self.get_similarity_scores(user_question)

        if not similarity_scores:
            return (None, 0) if return_confidence else None

        best_idx, best_score = similarity_scores[0]

        # Check if above threshold
        if best_score < threshold:
            return (None, best_score) if return_confidence else None

        # Store in conversation history
        self.conversation_history.append({
            'user': user_question,
            'bot': self.answers[best_idx],
            'confidence': best_score,
            'matched_question': self.questions[best_idx]
        })

        if return_confidence:
            return self.answers[best_idx], best_score
        return self.answers[best_idx]

    def get_multiple_answers(self, user_question: str,
                            top_k: int = 3,
                            threshold: float = 0.1) -> List[Tuple[str, str, float]]:
        """
        Get top-k matching answers with their questions and scores.
        """
        similarity_scores = self.get_similarity_scores(user_question)

        results = []
        for idx, score in similarity_scores[:top_k]:
            if score >= threshold:
                results.append((self.answers[idx], self.questions[idx], score))

        return results

    def handle_fallback(self, user_question: str) -> str:
        """Handle questions that don't match any FAQ"""
        fallback_responses = [
            "I'm not sure about that. Could you rephrase your question?",
            "I don't have an answer for that. Would you like to ask something else?",
            "That's outside my knowledge base. Please ask about our products or services.",
            "I'm still learning! Could you please ask a different question?",
            "Hmm, I don't understand. Can you try asking differently?"
        ]

        # Try to find suggestions
        processed = self.preprocess_text(user_question)
        keywords = processed.split()

        if keywords:
            suggestions = []
            for i, q in enumerate(self.processed_questions):
                q_keywords = set(q.split())
                if len(set(keywords) & q_keywords) >= 1:
                    suggestions.append(self.questions[i])

            if suggestions:
                suggestion_text = "\n\n You might want to ask about:\n• " + "\n• ".join(suggestions[:3])
                return fallback_responses[0] + suggestion_text

        return np.random.choice(fallback_responses)

    def get_conversation_summary(self) -> Dict:
        """Get summary of the conversation"""
        if not self.conversation_history:
            return {"total_queries": 0, "avg_confidence": 0, "topics": []}

        confidences = [h['confidence'] for h in self.conversation_history]
        topics = list(set([h['matched_question'][:50] for h in self.conversation_history]))

        return {
            "total_queries": len(self.conversation_history),
            "avg_confidence": np.mean(confidences),
            "topics": topics[:5]
        }


